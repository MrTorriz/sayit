# Path to the Whisper model (GGML format). Empty = auto: models/ggml-kb-whisper-medium-q5_0.bin
# inside the repo. Point it at another file to switch model, e.g. the large
# model for better accuracy (WER ~4.1-5.4 vs ~5.4-6.6 for medium on Swedish):
# MODEL_PATH="$HOME/path/to/sayit/models/ggml-kb-whisper-large-q5_0.bin"
MODEL_PATH=""

# whisper-cli from whisper.cpp (symlinked by install.sh)
WHISPER_CLI="$HOME/.local/bin/whisper-cli"

# whisper-server binary (for daemon mode)
WHISPER_SERVER="$HOME/.local/src/whisper.cpp/build/bin/whisper-server"

# Recording device. Empty = the mic of a connected Bluetooth headset (sayit
# switches its profile for the duration of the recording), otherwise the
# PipeWire default source. Set it to a PipeWire *node name* to always record
# from one dedicated microphone and leave a connected headset in A2DP:
#   pactl list sources short     # second column = the node name
#   AUDIO_SOURCE="alsa_input.usb-Vendor_Product-00.mono-fallback"
# Use the node name, never the numeric id shown by `wpctl status`: PipeWire
# reassigns ids on every reboot and re-plug, while the node name is derived
# from the device and survives both.
# Verify the result with: ./bin/sayit doctor
AUDIO_SOURCE=""

# Spoken language (ISO 639-1 code passed to whisper). The default model is
# KB-Whisper (Swedish); for other languages, download a matching Whisper model
# and set MODEL_PATH accordingly.
SPEECH_LANGUAGE="sv"

# CPU threads for whisper.cpp in the CLI fallback
THREADS=8

# Beam search size (more accurate than greedy; -1 = greedy). Default 5.
BEAM=5

# VAD model (Voice Activity Detection). Filters out non-speech before
# transcription -> less hallucination (ghost text/repetitions) on silence at
# the edges. Empty = auto: models/ggml-silero-v5.1.2.bin inside the repo.
# Point it at a missing file to disable VAD.
VAD_MODEL=""

# Initial prompt: primes the decoder so domain terms and names are spelled
# correctly up front (smarter than after-the-fact wordlist replacement).
# Write it in your dictation language and keep it short, e.g.:
# INITIAL_PROMPT="Dictation in Swedish. Terms: Whisper, Vulkan, PipeWire, GitHub."
INITIAL_PROMPT=""

# Optional: suppress specific recurring junk tokens via regex (in addition to
# -sns which is always on and removes non-speech tokens). Empty = off.
# Example that removes a stubborn hallucinated phrase:
# SUPPRESS_REGEX="Thanks for watching"
SUPPRESS_REGEX=""

# Port for the warm whisper-server (daemon mode)
DAEMON_PORT=9876

# Optional local LLM cleanup of the transcribed text (Ollama). Fixes spelling,
# split/merged words and obvious speech-to-text errors using context.
# NOTE: requires Ollama with GPU acceleration to be fast enough; on CPU it is
# too slow for dictation (~15 s) and a small model may even mangle technical
# terms. Off by default. 1 = on.
LLM_CLEANUP=0
LLM_MODEL="gemma2:2b"
LLM_URL="http://127.0.0.1:11434/api/generate"

# Assumed typing speed (words/min) for the "time saved" statistic in
# sayit-history --stat.
TYPING_WPM=40

# Persistent recording indicator (a non-expiring notification shown while the
# microphone is live, removed on stop/cancel). 0 = off.
RECORDING_INDICATOR=1

# Live microphone meter in Plasma's on-screen display while recording —
# visible feedback that dictation hears you. Needs the Plasma OSD service;
# silently off elsewhere. 0 = off.
RECORDING_METER=1

# Meter style:
#   overlay  a small pill of sayit's own, drawn above other windows: the mark
#            animates with your voice, clicks pass straight through it, and
#            you can put it anywhere (./bin/sayit-overlay --place). Needs a
#            Wayland session with layer-shell support plus the GTK bindings
#            listed as optional packages by install.sh.
#   mark     the animated mark in Plasma's on-screen display (theme icons).
#   wave     a scrolling bar waveform in the same Plasma OSD.
# Each style falls back to the next when its requirements are missing.
RECORDING_METER_STYLE="overlay"

# Wordlist with auto-replacements (grown by sayit-learn).
# Empty = auto: ~/.config/sayit/wordlist.tsv
WORDLIST=""
