# Path to the Whisper model (GGML format). Empty = auto: models/ggml-kb-whisper-medium-q5_0.bin
# inside the repo. Point it at another file to switch model, e.g. the large
# model for better accuracy (WER ~4.1-5.4 vs ~5.4-6.6 for medium on Swedish):
# MODEL_PATH="$HOME/path/to/sayit/models/ggml-kb-whisper-large-q5_0.bin"
MODEL_PATH=""

# whisper-cli from whisper.cpp (symlinked by install.sh)
WHISPER_CLI="$HOME/.local/bin/whisper-cli"

# whisper-server binary (for daemon mode)
WHISPER_SERVER="$HOME/.local/src/whisper.cpp/build/bin/whisper-server"

# Recording device. Empty = the mic of a connected Bluetooth headset (sayit
# switches its profile for the duration of the recording), otherwise the
# PipeWire default source. Set it to a PipeWire *node name* to always record
# from one dedicated microphone and leave a connected headset in A2DP:
#   pactl list sources short     # second column = the node name
#   AUDIO_SOURCE="alsa_input.usb-Vendor_Product-00.mono-fallback"
# Use the node name, never the numeric id shown by `wpctl status`: PipeWire
# reassigns ids on every reboot and re-plug, while the node name is derived
# from the device and survives both.
# Verify the result with: ./bin/sayit doctor
AUDIO_SOURCE=""

# Spoken language (ISO 639-1 code passed to whisper). The default model is
# KB-Whisper (Swedish); for other languages, download a matching Whisper model
# and set MODEL_PATH accordingly.
SPEECH_LANGUAGE="sv"

# CPU threads for whisper.cpp in the CLI fallback
THREADS=8

# Beam search size (more accurate than greedy; -1 = greedy). Default 5.
BEAM=5

# VAD model (Voice Activity Detection). Filters out non-speech before
# transcription -> less hallucination (ghost text/repetitions) on silence at
# the edges. Empty = auto: models/ggml-silero-v5.1.2.bin inside the repo.
# Point it at a missing file to disable VAD.
VAD_MODEL=""

# Voice activity detection, fine tuning. VAD_MODEL above decides whether VAD
# runs at all; these four decide how it cuts. All four are sent with each
# request, so a change takes effect on the next dictation without restarting the
# daemon, and all four need a decimal point - a decimal comma does not parse.

# Audio kept after the detected end of speech, in milliseconds. This is the only
# one of the four that actually lengthens the tail. whisper.cpp pins the end of a
# segment at the first 32 ms frame whose speech probability falls below
# VAD_THRESHOLD minus 0.15, and only this padding is added back afterwards.
# Swedish unvoiced finals (-t, -s, -st, -rt) run 80-150 ms and score low, which
# is why whisper.cpp's own default of 30 clips them off.
VAD_SPEECH_PAD_MS=250

# Speech probability above which Silero calls a 32 ms frame speech. whisper.cpp
# defaults to 0.5; lower catches quiet onsets and weak final consonants, at the
# cost of letting more background through.
VAD_THRESHOLD=0.30

# Speech segments shorter than this are discarded, in milliseconds. This is a
# correctness setting rather than a quality one: when every segment is discarded
# the transcription still succeeds, with an empty result and no error at all, so
# a one-word answer can vanish without a trace. whisper.cpp defaults to 250;
# sayit defaults to 0, which discards nothing.
VAD_MIN_SPEECH_MS=0

# Silence needed before a speech segment is closed, in milliseconds. whisper.cpp
# defaults to 100. Raising it joins phrases separated by short pauses into one
# segment. It does NOT lengthen the tail of the last one, however high it is set
# - VAD_SPEECH_PAD_MS is the only setting that does that.
VAD_MIN_SILENCE_MS=300

# Initial prompt: text the decoder is given as if it were the transcript of the
# segment just before this one. That is what the slot is for, and it is why a
# list of terms is the wrong shape for it. Measured across 11 datasets,
# biasing-word prompts cut rare-word errors from 23.7% to 18.0% but made the
# overall word error rate WORSE on 6 of the 11, and worse still as the list grew
# from 35 to 70 to 150 words (arXiv:2502.11572). A dictation is only a handful
# of words, so a long prompt leaves the decoder holding far more prior text than
# audio - the regime in which the model is reported to emit the prompt itself as
# the transcript.
#
# So either leave it empty, or write ONE short natural sentence in your dictation
# language - roughly 25 tokens at most - that reads like something you would
# actually say and happens to carry a few of your domain nouns in context:
# INITIAL_PROMPT="Jag skriver om Vulkan och PipeWire i vårt GitHub-projekt."
# Leave rare-term correction to the wordlist, which is deterministic and free.
#
# Two hard limits from whisper.cpp: the prompt is truncated to 224 tokens
# (n_text_ctx / 2), losing the tail; and a max_context of 0 disables the initial
# prompt outright, because the two sit behind the same guard.
INITIAL_PROMPT=""

# Optional: remove specific recurring junk via regex (in addition to -sns, which
# is always on and removes non-speech tokens). Empty = off. Example that removes
# a stubborn hallucinated phrase:
# SUPPRESS_REGEX="Thanks for watching"
#
# On Windows this is applied to the transcribed text, whichever path produced it,
# and the CLI fallback additionally suppresses matching tokens while decoding. It
# is never passed to whisper-server: that binary has no --suppress-regex option
# at all, and answers an unknown option by printing its usage and exiting with
# status 0 - so passing it made the warm daemon quit the moment it started, and
# look like a clean shutdown while doing it. A regex that does not compile is
# recorded as an error and ignored; it never costs you the dictation.
SUPPRESS_REGEX=""

# Port for the warm whisper-server (daemon mode)
DAEMON_PORT=9876

# Optional local LLM cleanup of the transcribed text (Ollama). Fixes spelling,
# split/merged words and obvious speech-to-text errors using context.
# NOTE: requires Ollama with GPU acceleration to be fast enough; on CPU it is
# too slow for dictation (~15 s) and a small model may even mangle technical
# terms. Off by default. 1 = on.
LLM_CLEANUP=0
LLM_MODEL="gemma2:2b"
LLM_URL="http://127.0.0.1:11434/api/generate"

# Assumed typing speed (words/min) for the "time saved" statistic in
# sayit-history --stat.
TYPING_WPM=40

# Persistent recording indicator (a non-expiring notification shown while the
# microphone is live, removed on stop/cancel). 0 = off.
RECORDING_INDICATOR=1

# Live microphone meter in Plasma's on-screen display while recording —
# visible feedback that dictation hears you. Needs the Plasma OSD service;
# silently off elsewhere. 0 = off.
RECORDING_METER=1

# Meter style:
#   overlay  a small pill of sayit's own, drawn above other windows: the mark
#            animates with your voice, clicks pass straight through it, and
#            you can put it anywhere (./bin/sayit-overlay --place). Needs a
#            Wayland session with layer-shell support plus the GTK bindings
#            listed as optional packages by install.sh.
#   mark     the animated mark in Plasma's on-screen display (theme icons).
#   wave     a scrolling bar waveform in the same Plasma OSD.
# Each style falls back to the next when its requirements are missing.
RECORDING_METER_STYLE="overlay"

# Wordlist with auto-replacements (grown by sayit-learn).
# Empty = auto: ~/.config/sayit/wordlist.tsv
WORDLIST=""

# --------------------------------------------------------------------------
# Windows only (win\). The Linux scripts in bin\ ignore everything below, and
# the Windows scripts read the settings above as well - only the values here
# have no Linux equivalent.
#
# Two of the settings above are shared but their defaults are Linux paths:
# WHISPER_CLI and WHISPER_SERVER. win\install.ps1 rewrites both when it
# creates .env, to the build it finds under %LOCALAPPDATA%\sayit\whisper.cpp:
#   WHISPER_CLI="%LOCALAPPDATA%\sayit\whisper.cpp\build-vulkan\bin\Release\whisper-cli.exe"
#   WHISPER_SERVER="%LOCALAPPDATA%\sayit\whisper.cpp\build-vulkan\bin\Release\whisper-server.exe"
# The directory is build-cpu instead when the machine has no Vulkan SDK.
# Windows values may use %VAR% for environment variables; $HOME is not expanded.
# --------------------------------------------------------------------------

# Push-to-talk button for win\sayit-trigger.ps1. Hold it to record, release to
# transcribe. Mouse side buttons are XBUTTON1 and XBUTTON2; MIDDLE is the wheel
# click; a keyboard key is VK followed by its virtual-key code, e.g. VK124 for
# F13. Run  .\win\sayit-trigger.ps1 -Probe  to see what your hardware reports.
# Note that some mice divert a thumb button in firmware, in which case it never
# reaches Windows until the vendor utility maps it to a real button.
TRIGGER_BUTTON="XBUTTON2"

# Swallow the trigger so the focused application never sees it. 0 = let it
# through (useful if you bind a key you also want to type).
TRIGGER_SUPPRESS=1

# How text is delivered to the focused window.
#   auto       type short text, paste longer text (recommended)
#   type       always SendInput with Unicode key events
#   clipboard  always clipboard plus Ctrl+V
INJECT_METHOD="auto"

# Length in characters above which "auto" switches from typing to pasting.
# Typing is capped by the OS at roughly 5000 characters and loses its ordering
# guarantee when another process holds a low-level keyboard hook.
INJECT_CLIPBOARD_THRESHOLD=100

# Hard cap on a single recording, in seconds. It bounds how long the microphone
# can stay open if whatever started the recording dies before stopping it.
MAX_RECORD_SECONDS=120

# Size of the recording indicator. 1.0 is 100x52 pixels; the pill and the mark
# inside it scale together. Values outside 0.5-4.0 are ignored and 1.0 is used.
# Use a decimal point, not a comma, whatever the system locale is.
# RECORDING_INDICATOR=0 (above) turns the indicator off entirely.
INDICATOR_SCALE=1.0

# Hide the indicator from screen captures, screen sharing and recordings, so a
# shared screen does not show that you are dictating. Needs Windows 10 2004 or
# later; on older builds the request is refused and the pill is captured as
# usual. Set to 0 if you want it to appear in a recorded demo.
INDICATOR_EXCLUDE_FROM_CAPTURE=1
