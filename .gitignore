# Models (downloaded by install.sh)
models/*.bin
models/*.gguf

# Recordings and temp files
*.wav
*.log
*.tmp

# Configuration with user-specific paths
.env

# Build artifacts (build/ also covers mac/build/, Sayit.app's staging;
# named here so the intent is explicit: built binaries are never committed)
build/
mac/build/

# Editor temp files
*~
*.swp
*.swo
.DS_Store

# Python cache (bin/sayit-overlay)
__pycache__/
*.pyc
