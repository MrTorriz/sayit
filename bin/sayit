#!/usr/bin/env bash
# sayit — main command: start/stop recording, transcribe, inject text
#
# Usage:
#   sayit           # toggle (default): press once = start, again = stop
#   sayit start     # hold-mode key-press: start recording
#   sayit stop      # hold-mode key-release: stop, transcribe, inject
#   sayit cancel    # discard the current recording without transcribing
#   sayit doctor    # read-only check of the recording path (see sayit-doctor)
#
# Behavior:
#   - Each recording session has its own WAV file and one session state file
#     in $XDG_RUNTIME_DIR (macOS: the per-user temporary directory; else /tmp):
#     sayit.session holds pid<TAB>wav<TAB>start.
#     stop/cancel claim the session atomically, so overlapping invocations can
#     never signal the wrong process or read another session's WAV.
#   - A short-lived intent marker (sayit.starting) covers the window while
#     start is still switching the Bluetooth profile; stop/cancel wait for it.
#   - PIDs from state files are only trusted after a process-identity check,
#     so a recycled PID is never signalled.
#   - Transcribed text is injected into the focused window via sayit-inject
#   - Every successful transcription is logged to
#     $XDG_DATA_HOME/sayit/history.jsonl
#   - Status notifications via notify-send (when available); on macOS the
#     last status goes to $XDG_RUNTIME_DIR/sayit.status for Sayit.app's menu
#     instead (a second line, warn or error, marks a problem), and
#     sayit.busy exists while a transcription runs, for Sayit's pill. The
#     text reaches sayit-inject on stdin. A persistent recording indicator
#     (sayit-indicator) is shown once
#     the microphone is actually live. Disable it with RECORDING_INDICATOR=0.
#   - Transcription errors are summarized in a notification and appended to
#     $XDG_RUNTIME_DIR/sayit-last-error.log (error class only — never text).
#   - SEGMENT_WHILE_RECORDING=1 (macOS): sayit-rec cuts the recording at
#     pauses and a background worker transcribes each piece while the
#     recording goes on (segment_worker), so stop only waits for the last one
#     and joins the texts. A recording that was never cut, or a piece that
#     failed, is transcribed whole, as without the setting.
#
# Exit codes:
#   0  Normal flow (including empty results — "Empty result" is notified)
#   1  Unknown argument, or the recorder failed to start

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
[[ -f "$REPO_ROOT/.env" ]] && source "$REPO_ROOT/.env"

# macOS has no XDG_RUNTIME_DIR. Its per-user temporary directory (mode 0700,
# private to the user, though on disk) plays the same role; exported, so every
# child and Sayit.app agree on it.
if [[ -z "${XDG_RUNTIME_DIR:-}" && "$OSTYPE" == darwin* ]]; then
    XDG_RUNTIME_DIR=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null) || XDG_RUNTIME_DIR=""
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR%/}"
    export XDG_RUNTIME_DIR
fi

RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}"
# Shared with the engine switcher. Children retain this lock while recording;
# stop/transcribe can run together, but a service restart cannot cut them off.
# flock(1) is util-linux: macOS has neither it nor the engine switcher.
if command -v flock >/dev/null; then
    exec 8>"$RUN_DIR/sayit-engine.lock"
    flock -sn 8 || { echo 'Engine switch in progress; try again when ready.' >&2; exit 1; }
fi
SESSION_FILE="$RUN_DIR/sayit.session"
INTENT_FILE="$RUN_DIR/sayit.starting"
ERROR_LOG="$RUN_DIR/sayit-last-error.log"
HIST="${XDG_DATA_HOME:-$HOME/.local/share}/sayit/history.jsonl"

MODE="${1:-toggle}"

# Optional latency profiling (SAYIT_PROFILE=1): appends run id, wall clock,
# monotonic uptime, stage and a numeric extra as CSV. Never any dictated text.
mark() {
    [[ -n "${SAYIT_PROFILE:-}" ]] || return 0
    local up now
    if [[ -r /proc/uptime ]]; then
        read -r up _ < /proc/uptime
    else
        # macOS: seconds since boot from kern.boottime ("{ sec = N, usec = M } ...").
        # Asked once and handed on to sayit-transcribe: a sysctl per mark
        # cost more than most of the stages being timed.
        if [[ ! "${SAYIT_BOOT:-}" =~ ^[0-9]+$ ]]; then
            SAYIT_BOOT=$(sysctl -n kern.boottime 2>/dev/null) || SAYIT_BOOT=""
            SAYIT_BOOT="${SAYIT_BOOT#*sec = }"; SAYIT_BOOT="${SAYIT_BOOT%%,*}"
            [[ "$SAYIT_BOOT" =~ ^[0-9]+$ ]] || SAYIT_BOOT=0
            export SAYIT_BOOT
        fi
        now="${EPOCHREALTIME/,/.}"
        up="$(( ${now%.*} - SAYIT_BOOT )).${now#*.}"
    fi
    printf '%s,%s,%s,%s,%s\n' "${SAYIT_PROFILE_RUN:-0}" "${EPOCHREALTIME/,/.}" "$up" \
        "$1" "${2:-}" >> "$RUN_DIR/sayit-profile.csv"
}

# Notification icon, resolved once per invocation on first use: the sayit
# mark when its theme icons are installed (tone via the portal color-scheme,
# "uint32 1" = dark UI -> the light-glyph default variant), else a standard
# theme icon. Lazy so invocations without icons never pay the D-Bus call.
SAYIT_ICON=""
resolve_notify_icon() {
    [[ -n "$SAYIT_ICON" ]] && return 0
    SAYIT_ICON="audio-input-microphone"
    local root="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
    if [[ -f "$root/sayit.svg" ]]; then
        local suffix="" reply
        # Short timeout: a wedged portal must never stall a notification.
        reply=$(gdbus call --session --timeout 1 \
            --dest org.freedesktop.portal.Desktop \
            --object-path /org/freedesktop/portal/desktop \
            --method org.freedesktop.portal.Settings.Read \
            org.freedesktop.appearance color-scheme 2>/dev/null) || reply=""
        [[ -z "$reply" || "$reply" == *"uint32 1"* ]] || suffix="-light"
        [[ -f "$root/sayit$suffix.svg" ]] || suffix=""
        SAYIT_ICON="sayit$suffix"
    fi
}

notify() {
    # macOS: no notifications - Notification Center would keep every one,
    # dictated snippets included. Sayit.app shows the last status in its menu
    # bar item; a "Done" status loses its text on the way. The optional
    # second argument (warn or error) becomes a second line, which turns
    # Sayit's menu bar icon into a warning for a few seconds.
    if [[ "$OSTYPE" == darwin* ]]; then
        local status="$1"
        [[ "$status" == "Done ("*"): "* ]] && status="${status%%): *})"
        printf '%s\n' "$status" ${2:+"$2"} > "$RUN_DIR/sayit.status" 2>/dev/null || true
        return 0
    fi
    command -v notify-send >/dev/null || return 0
    # The notification body is parsed as markup by the server: escape it so
    # dictated text containing & or < renders literally instead of vanishing.
    local body="$1"
    # Quoted replacements: & is otherwise special under bash 5.2's default
    # patsub_replacement shopt and would expand to the matched string.
    body="${body//&/"&amp;"}"
    body="${body//</"&lt;"}"
    body="${body//>/"&gt;"}"
    # --transient keeps dictation snippets out of the notification history,
    # but libnotify < 0.8 rejects the flag — probe before using it.
    local eflag=()
    notify-send --help 2>/dev/null | grep -q -- --transient && eflag=(-e)
    resolve_notify_icon
    notify-send "${eflag[@]}" -t 1500 -i "$SAYIT_ICON" "sayit" "$body" || true
}

# The feedback toggles (RECORDING_INDICATOR for the notification,
# RECORDING_METER for the OSD meter) live inside sayit-indicator itself, so
# the two stay independent and hide always reaches a running meter.
indicator() {
    # macOS: the indicator is a marker file Sayit.app watches. The two lines
    # of bin/sayit-indicator's Darwin branch are repeated here, because
    # starting that script cost 11 ms between the release and the paste.
    if [[ "$OSTYPE" == darwin* ]]; then
        case "${1:-}" in
            show) [[ "${RECORDING_INDICATOR:-1}" == "0" ]] || : > "$RUN_DIR/sayit.indicator.on" ;;
            hide) rm -f "$RUN_DIR/sayit.indicator.on" ;;
        esac 2>/dev/null || true
        return 0
    fi
    "$REPO_ROOT/bin/sayit-indicator" "$@" 2>/dev/null || true
}

# Restore the headset's previous profile. macOS switches a headset by itself
# when capture opens and closes it, so sayit-bt has nothing to do there and
# is not started at all: it would only stand between the release and the text.
bt_down() {
    [[ "$OSTYPE" == darwin* ]] && return 0
    "$REPO_ROOT/bin/sayit-bt" down 2>/dev/null || true
}

# macOS keeps only the last status. A stop or cancel that finds no session
# right after a failed start would replace the reason with "No recording in
# progress" - the hold-to-talk release always arrives just then.
recent_failure() {
    [[ "$OSTYPE" == darwin* ]] || return 1
    local file="$RUN_DIR/sayit.status" level="" modified
    { read -r _ && read -r level; } < "$file" 2>/dev/null || return 1
    [[ "$level" == error ]] || return 1
    modified=$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null) || return 1
    (( ${EPOCHREALTIME%[.,]*} - modified < 10 ))
}

# "Recording failed to start", with the recorder's own reason when it gave
# one: what it wrote to the error log after offset $1 (sayit-rec names the
# missing device or the denied permission there).
start_failed() {
    local why
    why=$(tail -c +$(( ${1:-0} + 1 )) "$ERROR_LOG" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 1) || why=""
    why="${why#sayit-rec: }"
    if [[ -n "$why" ]]; then
        notify "Recording failed to start: ${why:0:160}" error
    else
        notify "Recording failed to start — check the microphone" error
    fi
}

# A PID from a state file is only trusted while its command line names the
# session's own (unique) WAV path — true both before exec (the sayit-record
# wrapper) and after (pw-record's or sayit-rec's outfile argument). Guards
# against PID recycling: a reused PID, even another recorder, is never
# signalled. macOS has no /proc; ps reports the same command line there.
is_recorder() {
    local pid="${1:-0}" wav="${2:-}" cmdline
    [[ -n "$wav" ]] || return 1
    if [[ -d /proc ]]; then
        cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
    else
        [[ "$pid" =~ ^[0-9]+$ ]] || return 1
        cmdline=$(ps -o command= -p "$pid" 2>/dev/null) || return 1
    fi
    [[ "$cmdline" == *"$wav"* ]]
}

# Atomically claim the current session (mv: exactly one stop/cancel wins).
# Sets REC_PID, REC_WAV, REC_START. Fails when no valid session exists.
claim_session() {
    local claimed="$SESSION_FILE.claimed.$$"
    mv "$SESSION_FILE" "$claimed" 2>/dev/null || return 1
    IFS=$'\t' read -r REC_PID REC_WAV REC_START < "$claimed" || true
    rm -f "$claimed"
    [[ "${REC_PID:-}" =~ ^[0-9]+$ && -n "${REC_WAV:-}" ]] || return 1
}

# Stop the recorder (identity-checked) and wait, bounded, until it has
# actually exited — pw-record must drain buffers and finalize the WAV header
# before the file can be transcribed or deleted. SIGINT first (pw-record's
# graceful path); SIGTERM as a fallback, since SIGINT can arrive ignored
# through exotic spawn chains while SIGTERM never does. Both signals were
# verified to leave a finalized, valid WAV.
stop_recorder() {
    is_recorder "${REC_PID:-0}" "${REC_WAV:-}" || return 0
    kill -INT "$REC_PID" 2>/dev/null || true
    # Generous SIGINT window (~2 s): a recorder that received the signal and
    # is flushing must never be interrupted mid-finalization by the fallback.
    # The first looks come quickly: a recorder is normally gone within a few
    # milliseconds, and a whole 20 ms sleep there was time before the text.
    local i
    for i in $(seq 1 120); do
        kill -0 "$REC_PID" 2>/dev/null || return 0
        if (( i <= 20 )); then sleep 0.005; else sleep 0.02; fi
    done
    kill -TERM "$REC_PID" 2>/dev/null || true
    for _ in $(seq 1 50); do
        kill -0 "$REC_PID" 2>/dev/null || return 0
        sleep 0.02
    done
}

# Remove an intent marker whose owning start process no longer exists (a
# crashed start). A marker with unreadable/invalid content is also removed.
clear_dead_intent() {
    local owner
    owner=$(cat "$INTENT_FILE" 2>/dev/null) || return 0
    if [[ ! "$owner" =~ ^[0-9]+$ ]] || ! kill -0 "$owner" 2>/dev/null; then
        rm -f "$INTENT_FILE"
    fi
}

# Wait for a session while a start is still in flight (hold-mode: the release
# can arrive during the Bluetooth switch). Returns as soon as the session
# exists, or immediately when no start is in progress; an intent left behind
# by a crashed start is cleared instead of being waited on.
await_session() {
    for _ in $(seq 1 30); do
        [[ -f "$SESSION_FILE" ]] && return 0
        clear_dead_intent
        [[ -f "$INTENT_FILE" ]] || return 0
        sleep 0.1
    done
}

# SEGMENT_WHILE_RECORDING (macOS): runs in the background for the whole
# session, on the recorder's stdout, where sayit-rec names each piece it cut
# at a pause. Each is transcribed as it comes, with the previous piece's text
# as its prompt, into <stem>-part-<n>.txt. The state file <stem>.segments
# holds this worker's PID until the recorder has exited (end of input), then
# done<TAB>pieces<TAB>ok|failed. A state file that is gone means the session
# was cancelled or already handled: then the pieces are dropped, not
# transcribed, and whatever this worker wrote is removed.
segment_worker() {  # segment_worker <stem>
    local stem="$1" state="$1.segments" part n=0 rc=ok prev=/dev/null txt
    umask 077
    printf '%s\n' "$BASHPID" > "$state" || return 0
    while IFS= read -r part; do
        n=$(( n + 1 ))
        txt="$stem-part-$n.txt"
        # A piece out of order (one sayit-rec could not write) spoils the
        # join: stop then transcribes the whole recording instead.
        [[ "$part" == "$stem-part-$n.wav" ]] || rc=failed
        if [[ "$rc" == ok && -f "$state" ]]; then
            mark segment.begin "$n"
            if "$REPO_ROOT/bin/sayit-transcribe" --part "$part" < "$prev" > "$txt.tmp" \
                && mv "$txt.tmp" "$txt"; then
                prev="$txt"
            else
                rc=failed
            fi
            mark segment.end "$n"
        fi
        rm -f "$part" "$txt.tmp"
    done
    if [[ -f "$state" ]]; then
        printf 'done\t%s\t%s\n' "$n" "$rc" > "$state.tmp" && mv "$state.tmp" "$state"
    else
        rm -f "$stem-part-"*
    fi
}

# Waits for this session's segment worker and sets SEGMENT_TEXTS to its texts
# in order. Fails when there is nothing to join (no cut, a failed piece, a
# worker that died), which leaves the whole recording to the usual path. The
# wait is bounded by the recording's length, like the transcription's own
# deadline.
await_segments() {  # await_segments <stem>
    local stem="$1" state n status i limit
    SEGMENT_TEXTS=()
    limit=$(( $(wc -c 2>/dev/null < "$REC_WAV" || echo 0) * 2 / 32000 + 20 ))
    for (( i = 0; i < limit * 100; i++ )); do
        state=""
        { IFS= read -r state < "$stem.segments"; } 2>/dev/null || [[ -n "$state" ]] || return 1
        [[ "$state" == done$'\t'* ]] && break
        [[ "$state" =~ ^[0-9]+$ ]] && ! kill -0 "$state" 2>/dev/null && return 1
        sleep 0.01
    done
    IFS=$'\t' read -r _ n status <<< "$state"
    [[ "$status" == ok && "$n" =~ ^[1-9][0-9]*$ ]] || return 1
    for (( i = 1; i <= n; i++ )); do
        [[ -f "$stem-part-$i.txt" ]] || return 1
        SEGMENT_TEXTS+=("$stem-part-$i.txt")
    done
}

start_recording() {
    mark start.enter
    # Refuse when a session is already live; clean up leftovers of a crash.
    if [[ -f "$SESSION_FILE" ]]; then
        local pid wav
        IFS=$'\t' read -r pid wav _ < "$SESSION_FILE" || true
        if is_recorder "${pid:-}" "${wav:-}"; then
            notify "Already recording"
            return 0
        fi
        rm -f "$SESSION_FILE"
        [[ -n "${wav:-}" ]] && rm -f "$wav"
    fi

    # Claim the start intent atomically (noclobber) so two concurrent starts
    # can never spawn two recorders. The marker holds the owner's PID: it is
    # only ever reclaimed when that owner no longer exists, so a start that is
    # merely slow (wedged PipeWire, suspend/resume) is never taken over.
    if ! (set -C; echo "$$" > "$INTENT_FILE") 2>/dev/null; then
        clear_dead_intent
        (set -C; echo "$$" > "$INTENT_FILE") 2>/dev/null || return 0
    fi

    # Remove files orphaned by crashed sessions (unique names, tmpfs).
    find "$RUN_DIR" -maxdepth 1 \
        \( -name 'sayit-*.wav' -o -name 'sayit.session.claimed.*' \
           -o -name 'sayit.session.tmp.*' -o -name 'sayit.terr.*' \
           -o -name 'sayit-clipboard.*' -o -name 'sayit-*-part-*' \
           -o -name 'sayit-*.segments*' \) \
        -mmin +60 -delete 2>/dev/null || true

    # A configured AUDIO_SOURCE means a dedicated microphone is in use, so
    # leave Bluetooth alone: switching a connected headset to its call
    # profile would wreck playback quality and hand us the wrong microphone.
    # Otherwise switch the headset to its headset profile so its mic becomes
    # available — empty when no Bluetooth headset is connected.
    if [[ -n "${AUDIO_SOURCE:-}" ]]; then
        SOURCE="$AUDIO_SOURCE"
    elif [[ "$OSTYPE" == darwin* ]]; then
        # Nothing to switch on macOS (see bt_down), and here the script would
        # delay the recorder itself: the microphone opens that much sooner.
        SOURCE=""
    else
        # stderr to the error log, not /dev/null: a switch that keeps failing
        # would otherwise be invisible — recording silently falls back to the
        # default mic and nothing anywhere says why.
        SOURCE=$("$REPO_ROOT/bin/sayit-bt" up 2>>"$ERROR_LOG" || true)
    fi
    mark bt_up.end

    # Defensive ownership re-check after the (long) Bluetooth switch: with the
    # owner-PID model a live start cannot lose its intent, so a mismatch means
    # something external interfered — back off without touching shared state.
    [[ "$(cat "$INTENT_FILE" 2>/dev/null)" == "$$" ]] || return 0

    local wav="$RUN_DIR/sayit-$$.wav" start pid errmark
    # EPOCHREALTIME rather than date +%s.%N: older BSD date prints a literal N.
    start="${EPOCHREALTIME/,/.}"
    # Where the recorder's stderr starts, for start_failed.
    errmark=$(( $(wc -c 2>/dev/null < "$ERROR_LOG" || echo 0) ))
    # Detach the recorder's stdio from the caller (Solaar/hotkey handler):
    # its stderr goes to the error log, never to the caller's pipes.
    # Job control (set -m) gives the child a default SIGINT disposition —
    # async children of a non-interactive shell otherwise ignore SIGINT,
    # which would make the stop signal a no-op for shell-based recorders.
    set -m
    if [[ "$OSTYPE" == darwin* && "${SEGMENT_WHILE_RECORDING:-0}" == 1 ]]; then
        # The worker reads the recorder's stdout; it is the recorder's own
        # child, so $! stays the recorder.
        SAYIT_SEGMENTS=1 "$REPO_ROOT/bin/sayit-record" "$wav" "$SOURCE" \
            > >(segment_worker "${wav%.wav}" >/dev/null 2>>"$ERROR_LOG") 2>>"$ERROR_LOG" &
    else
        "$REPO_ROOT/bin/sayit-record" "$wav" "$SOURCE" >/dev/null 2>>"$ERROR_LOG" &
    fi
    pid=$!
    set +m
    disown
    mark record.spawned "$pid"

    # Publish the session immediately, then verify. If this process were
    # killed mid-verification, the recorder is still reachable through the
    # session file — never an orphaned hot microphone.
    #
    # A write that fails is that same hazard by another route: a full or
    # read-only run directory would abort start here, under set -e, with the
    # recorder already spawned and disowned and nothing left able to name it.
    # Stop the recorder ourselves rather than let the error out.
    if ! { printf '%s\t%s\t%s\n' "$pid" "$wav" "$start" > "$SESSION_FILE.tmp.$$" &&
           mv "$SESSION_FILE.tmp.$$" "$SESSION_FILE"; } 2>/dev/null; then
        # An unremovable leftover must not abort the cleanup: the whole
        # point of this branch is that the run directory is already failing.
        rm -f "$SESSION_FILE.tmp.$$" 2>/dev/null || true
        REC_PID="$pid" REC_WAV="$wav" stop_recorder
        rm -f "$wav" "${wav%.wav}.segments" "$INTENT_FILE" 2>/dev/null || true
        printf '%s start: could not commit the session file\n' \
            "$(date -Iseconds)" >> "$ERROR_LOG" 2>/dev/null || true
        indicator hide
        bt_down
        notify "Recording failed to start — check the microphone" error
        return 1
    fi
    rm -f "$INTENT_FILE"
    mark session.written

    # Verify the recorder actually came up — exec pw-record dies instantly
    # when PipeWire is down or the recording source is bad.
    sleep 0.3
    if ! kill -0 "$pid" 2>/dev/null; then
        # Retract OUR session only (compare-then-claim): if a concurrent stop
        # already claimed it, that stop owns the outcome and we back off.
        if [[ "$(cat "$SESSION_FILE" 2>/dev/null)" == "$pid"$'\t'"$wav"$'\t'"$start" ]] \
            && mv "$SESSION_FILE" "$SESSION_FILE.claimed.$$" 2>/dev/null; then
            rm -f "$SESSION_FILE.claimed.$$" "$wav" "${wav%.wav}.segments"
            indicator hide
            bt_down
            start_failed "$errmark"
            return 1
        fi
        return 0
    fi
    notify "Recording"
    indicator show "$SOURCE"
    # A very quick release can claim and stop this session while we were
    # still between the liveness check and the show above — its hide then
    # ran before our show and nothing would ever take the feedback down
    # (the meter would keep an OSD and its own capture stream alive with
    # no recording behind them). Re-check ownership: if the session is no
    # longer ours, the stop that took it has already passed its hide, so
    # hiding here cannot race it.
    if [[ "$(cat "$SESSION_FILE" 2>/dev/null)" != "$pid"$'\t'"$wav"$'\t'"$start" ]]; then
        indicator hide
    fi
}

stop_and_inject() {
    mark stop.enter
    # Arm the crash guard before touching the session: from here on a signal
    # must not leave a hot microphone or a stuck audio profile. The trap is
    # narrow on purpose — it never hides the indicator (a newer session may
    # own it by then) and is dropped as soon as the recorder is down.
    trap 'stop_recorder 2>/dev/null || true;
          bt_down; exit 130' INT TERM HUP
    await_session
    if ! claim_session; then
        trap - INT TERM HUP
        indicator hide
        recent_failure || notify "No recording in progress"
        return 0
    fi
    mark session.claimed
    # The session is claimed: give release feedback immediately. A follow-up
    # start shows its own indicator no earlier than 0.3 s from now, so this
    # hide can never race a newer session's show.
    indicator hide

    # A recorder that is already gone ended on its own: MAX_RECORD_SECONDS,
    # or the device went away. Say so, rather than look like a normal stop.
    local ended=""
    is_recorder "$REC_PID" "$REC_WAV" || ended="; the recording had already stopped"
    stop_recorder
    mark record.killed
    END="${EPOCHREALTIME/,/.}"

    # Restore the headset's previous profile (A2DP) once recording is done.
    bt_down
    mark bt_down.end
    # Recorder stopped and profile restored — nothing hot remains to protect.
    trap - INT TERM HUP

    notify "Transcribing..."
    # macOS: Sayit's pill shows a working state while this marker exists.
    if [[ "$OSTYPE" == darwin* ]]; then
        : > "$RUN_DIR/sayit.busy" 2>/dev/null || true
        trap 'rm -f "$RUN_DIR/sayit.busy"' EXIT
    fi
    local terr trc=0 stem="${REC_WAV%.wav}"
    terr="$RUN_DIR/sayit.terr.$$"
    mark transcribe.begin
    if [[ -f "$stem.segments" ]] && await_segments "$stem"; then
        mark segments.ready "${#SEGMENT_TEXTS[@]}"
        TEXT=$("$REPO_ROOT/bin/sayit-transcribe" --join "${SEGMENT_TEXTS[@]}" 2>"$terr") || trc=$?
    else
        TEXT=$("$REPO_ROOT/bin/sayit-transcribe" "$REC_WAV" 2>"$terr") || trc=$?
    fi
    mark transcribe.end "${#TEXT}"
    rm -f "$REC_WAV" "$stem.segments" "$stem-part-"*

    if [[ -n "${TEXT// }" ]]; then
        # The text goes on stdin: argv shows in every user's process listing.
        local irc=0
        printf '%s' "$TEXT" | "$REPO_ROOT/bin/sayit-inject" || irc=$?
        rm -f "$RUN_DIR/sayit.busy"
        # Arithmetic drops the padding BSD wc puts before the count.
        WORDS=$(( $(printf '%s\n' "$TEXT" | wc -w) ))
        case $irc in
            0) notify "Done ($WORDS words$ended): ${TEXT:0:60}" ;;
            2) notify "Not pasted: Sayit needs the Accessibility permission — the text is on the clipboard, press Cmd+V" error ;;
            3) notify "Secure Input is on, so the paste may have been blocked — the text is on the clipboard, press Cmd+V" warn ;;
            *) notify "Injection failed — recover with: sayit-history --inject" error ;;
        esac
        mark inject.end

        # Append to history. The text goes via stdin (not argv) and the
        # duration is computed in python: float() always parses the period
        # decimal both timestamps carry (EPOCHREALTIME with any locale comma
        # replaced), regardless of locale.
        mkdir -p "$(dirname "$HIST")"
        if ! printf '%s' "$TEXT" | python3 -c "
import json, sys, datetime
try:
    seconds = round(float(sys.argv[2]) - float(sys.argv[1]), 2)
    if seconds < 0:
        seconds = 0.0
except ValueError:
    seconds = 0.0
print(json.dumps({
    'time': datetime.datetime.now().isoformat(timespec='seconds'),
    'seconds': seconds,
    'words': int(sys.argv[3]),
    'text': sys.stdin.read()
}, ensure_ascii=False))
" "${REC_START:-0}" "$END" "$WORDS" >> "$HIST"; then
            notify "History write failed" warn
        fi
        mark history.done
    elif (( trc != 0 )); then
        # Surface the error class (never dictated text) instead of a
        # misleading "Empty result".
        local why
        why=$(tail -n 1 "$terr" 2>/dev/null || true)
        {
            printf '%s stop: sayit-transcribe exit %s\n' \
                "$(date -Iseconds)" "$trc"
            cat "$terr" 2>/dev/null
        } >> "$ERROR_LOG" || true
        notify "Transcription failed: ${why:-exit $trc (see sayit-last-error.log)}" error
    else
        notify "Empty result" warn
    fi
    rm -f "$terr"
}

cancel_recording() {
    trap 'stop_recorder 2>/dev/null || true;
          bt_down; exit 130' INT TERM HUP
    await_session
    if ! claim_session; then
        trap - INT TERM HUP
        indicator hide
        recent_failure || notify "No recording in progress"
        return 0
    fi
    indicator hide
    # Gone before the recorder stops, so its worker transcribes no more.
    rm -f "${REC_WAV%.wav}.segments"
    stop_recorder
    rm -f "$REC_WAV" "${REC_WAV%.wav}-part-"*
    bt_down
    trap - INT TERM HUP
    notify "Recording cancelled — nothing injected"
}

case "$MODE" in
    start)
        start_recording ;;
    stop)
        stop_and_inject ;;
    cancel)
        cancel_recording ;;
    doctor)
        shift
        exec "$REPO_ROOT/bin/sayit-doctor" "$@" ;;
    toggle|"")
        # Only treat the session as "recording" if its PID still names our
        # recorder — a stale session from a crash means: start fresh instead
        # (start_recording cleans up the leftovers).
        live=""
        if [[ -f "$SESSION_FILE" ]]; then
            IFS=$'\t' read -r tpid twav _ < "$SESSION_FILE" || true
            is_recorder "${tpid:-}" "${twav:-}" && live=1
        fi
        if [[ -n "$live" || -f "$INTENT_FILE" ]]; then
            stop_and_inject
        else
            start_recording
        fi ;;
    *)
        echo "Usage: sayit [toggle|start|stop|cancel|doctor]" >&2
        exit 1 ;;
esac
