#!/usr/bin/env bash
# sayit-transcribe — transcribe a WAV file with whisper.cpp
#
# Usage:
#   sayit-transcribe <file.wav>
#
# Arguments:
#   file.wav  16 kHz mono PCM file (same format as sayit-record produces)
#
# Behavior:
#   - Daemon first: POSTs to a warm whisper-server when it responds. The CLI
#     fallback (whisper-cli, cold start) runs ONLY on a transport failure —
#     an empty transcription from a healthy daemon is authoritative (silence)
#     and is never re-run. whisper-cli and the model file are required only
#     for the fallback path, never while the daemon serves.
#   - Reads configuration from .env. SPEECH_LANGUAGE, INITIAL_PROMPT and the
#     four VAD tuning settings (VAD_SPEECH_PAD_MS, VAD_THRESHOLD,
#     VAD_MIN_SPEECH_MS, VAD_MIN_SILENCE_MS) apply per request on both paths;
#     THREADS, BEAM and VAD_MODEL apply to the CLI fallback — the daemon fixes
#     those at server start (restart sayit-daemon.service after changing them).
#     SUPPRESS_REGEX applies to the CLI fallback, and to the daemon only when
#     the whisper-server build supports the flag. SAYIT_MODEL overrides
#     MODEL_PATH on both paths.
#   - A WAV with no samples returns empty without contacting either path.
#   - Applies the wordlist as case-insensitive word-boundary replacements
#   - Prints normalized text on stdout (no newlines, tabs or status lines).
#     stderr carries error classes only — never transcribed text.
#
# Exit codes:
#   0  Successful transcription (even when the result is empty)
#   1  File missing, or transcription failed on both the daemon and CLI paths

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
[[ -f "$REPO_ROOT/.env" ]] && source "$REPO_ROOT/.env"

WAV="${1:?Usage: sayit-transcribe <file.wav>}"
[[ -f "$WAV" ]] || { echo "File not found: $WAV" >&2; exit 1; }

WHISPER_CLI="${WHISPER_CLI:-$HOME/.local/bin/whisper-cli}"
# SAYIT_MODEL (environment variable) wins over .env:MODEL_PATH — same
# precedence as sayit-daemon, so A/B model switching stays consistent.
MODEL="${SAYIT_MODEL:-${MODEL_PATH:-$REPO_ROOT/models/ggml-kb-whisper-medium-q5_0.bin}}"

SPEECH_LANGUAGE="${SPEECH_LANGUAGE:-sv}"
THREADS="${THREADS:-8}"
BEAM="${BEAM:-5}"
DAEMON_PORT="${DAEMON_PORT:-9876}"
DAEMON_URL="http://127.0.0.1:${DAEMON_PORT}/inference"
INITIAL_PROMPT="${INITIAL_PROMPT:-}"
VAD_MODEL="${VAD_MODEL:-$REPO_ROOT/models/ggml-silero-v5.1.2.bin}"
# VAD tuning. These defaults are not whisper.cpp's. It ends a speech segment at
# the first 32 ms frame whose speech probability drops below VAD_THRESHOLD minus
# 0.15 and adds back only VAD_SPEECH_PAD_MS, so its own default of 30 ms cuts
# inside the 80-150 ms a Swedish unvoiced final (-t, -s, -st, -rt) occupies.
# VAD_MIN_SPEECH_MS is a correctness setting rather than a quality one: whisper
# discards shorter segments, and when every segment goes the transcription still
# succeeds - empty, with no error - so a one-word answer can vanish silently.
VAD_SPEECH_PAD_MS="${VAD_SPEECH_PAD_MS:-250}"
VAD_THRESHOLD="${VAD_THRESHOLD:-0.30}"
VAD_MIN_SPEECH_MS="${VAD_MIN_SPEECH_MS:-0}"
VAD_MIN_SILENCE_MS="${VAD_MIN_SILENCE_MS:-300}"
SUPPRESS_REGEX="${SUPPRESS_REGEX:-}"
LLM_CLEANUP="${LLM_CLEANUP:-0}"
LLM_MODEL="${LLM_MODEL:-gemma2:2b}"
LLM_URL="${LLM_URL:-http://127.0.0.1:11434/api/generate}"

mark() {
    [[ -n "${SAYIT_PROFILE:-}" ]] || return 0
    local up
    read -r up _ < /proc/uptime
    printf '%s,%s,%s,%s,%s\n' "${SAYIT_PROFILE_RUN:-0}" "${EPOCHREALTIME/,/.}" "$up" \
        "$1" "${2:-}" >> "${XDG_RUNTIME_DIR:-/tmp}/sayit-profile.csv"
}

# Warm daemon (whisper-server): the model is already in RAM/GPU, so the model
# load per call disappears. Whether VAD runs at all, along with beam and
# flash-attn, is fixed at server start; the prompt and the VAD tuning are sent
# per request (--form-string keeps a value starting with @ or < literal —
# curl -F would treat it as a file reference).
transcribe_daemon() {
    command -v curl >/dev/null || return 1
    # Deadline scales with the audio length (16 kHz mono s16 = 32000 bytes/s)
    # so a hung or busy server cannot stall a short dictation for long.
    local bytes deadline
    bytes=$(stat -c %s "$WAV" 2>/dev/null || echo 0)
    deadline=$(( bytes / 32000 + 10 ))
    # The prompt field is sent even when empty: older whisper-server builds
    # only reset request params after a successful request, so an explicit
    # empty value is the safe way to clear any previous prompt.
    local args=( -sf --connect-timeout 2 -m "$deadline"
                 -F file=@"$WAV"
                 --form-string language="$SPEECH_LANGUAGE"
                 --form-string prompt="$INITIAL_PROMPT"
                 --form-string response_format=text )
    # VAD tuning travels with the request, so a change in .env takes effect on
    # the next dictation without restarting the daemon. The server reads these
    # in the C locale, where a decimal comma parses as a whole number: "0,30"
    # would arrive as a threshold of 30 and silence every dictation.
    if [[ -f "$VAD_MODEL" ]]; then
        args+=( --form-string vad_speech_pad_ms="$VAD_SPEECH_PAD_MS"
                --form-string vad_threshold="$VAD_THRESHOLD"
                --form-string vad_min_speech_duration_ms="$VAD_MIN_SPEECH_MS"
                --form-string vad_min_silence_duration_ms="$VAD_MIN_SILENCE_MS" )
    fi
    curl "${args[@]}" "$DAEMON_URL" 2>/dev/null
}

# Cold CLI fallback. whisper-cli and the model file are checked here — not up
# front — so a healthy daemon keeps working without them.
transcribe_cli() {
    [[ -x "$WHISPER_CLI" ]] || { echo "whisper-cli missing — run install.sh" >&2; return 1; }
    [[ -f "$MODEL" ]] || { echo "Model missing: $MODEL — run install.sh" >&2; return 1; }
    # -nt: no timestamps; -np: no status lines; -fa: flash attention;
    # -bs: beam search (more accurate than greedy); --vad: filter non-speech;
    # -sns: suppress non-speech tokens (e.g. [music], brackets, noise).
    local cli_args=(-m "$MODEL" -l "$SPEECH_LANGUAGE" -t "$THREADS" -bs "$BEAM" -fa -sns -nt -np)
    if [[ -f "$VAD_MODEL" ]]; then
        cli_args+=(--vad -vm "$VAD_MODEL"
                   -vp "$VAD_SPEECH_PAD_MS" -vt "$VAD_THRESHOLD"
                   -vspd "$VAD_MIN_SPEECH_MS" -vsd "$VAD_MIN_SILENCE_MS")
    fi
    [[ -n "$INITIAL_PROMPT" ]] && cli_args+=(--prompt "$INITIAL_PROMPT")
    [[ -n "$SUPPRESS_REGEX" ]] && cli_args+=(--suppress-regex "$SUPPRESS_REGEX")
    "$WHISPER_CLI" "${cli_args[@]}" -f "$WAV" 2>/dev/null
}

# Optional local LLM cleanup (Ollama): fixes spelling, merged/split words and
# obvious speech-to-text errors using context, without changing the meaning.
# Falls back to the original text on error/timeout. Enabled with LLM_CLEANUP=1.
llm_cleanup() {
    python3 - "$LLM_URL" "$LLM_MODEL" "$1" <<'PYEOF'
import sys, json, urllib.request
url, model, text = sys.argv[1], sys.argv[2], sys.argv[3]
prompt = ("You correct speech-to-text output. Return EXACTLY the same sentence "
          "but fix spelling errors, stray spaces inside words and obvious "
          "mistranscriptions. Do NOT change the meaning, do NOT add or remove "
          "information, write NO comments or explanations. Keep the original "
          "language. Reply with the corrected text only.\n\n"
          "Text: " + text)
payload = json.dumps({"model": model, "prompt": prompt, "stream": False,
                      "options": {"temperature": 0}}).encode()
try:
    req = urllib.request.Request(url, data=payload,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        out = json.loads(r.read()).get("response", "").strip()
    print(out if out else text)
except Exception:
    print(text)
PYEOF
}

# A WAV with no samples is what a very short press leaves behind. Both paths
# reject it - the daemon answers HTTP 400 "Invalid request", which curl -f turns
# into the same exit status as an unreachable daemon - so the CLI fallback would
# run and be told the same thing at 20 times the cost. There is no speech in a
# file with no audio, so answer that here. 44 bytes is a WAV header and nothing
# else.
if (( $(stat -c %s "$WAV" 2>/dev/null || echo 0) <= 44 )); then
    mark t.empty
    printf ''
    exit 0
fi

# Daemon first. A transport failure (connection refused, timeout, HTTP error)
# triggers the CLI fallback; an EMPTY 200 response is a real "no speech"
# answer and must not cost a second, cold transcription of the same silence.
mark t.daemon.begin
daemon_rc=0
RAW=$(transcribe_daemon) || daemon_rc=$?
mark t.daemon.end "$daemon_rc"
if (( daemon_rc != 0 )); then
    cli_rc=0
    mark t.cli.begin
    RAW=$(transcribe_cli) || cli_rc=$?
    mark t.cli.end "$cli_rc"
    if (( cli_rc != 0 )); then
        echo "transcription failed: daemon unreachable (curl exit $daemon_rc), CLI fallback failed (exit $cli_rc)" >&2
        exit 1
    fi
fi

# Normalize: strip special tokens (<|nospeech|> etc.), trim, join lines
RAW=$(printf '%s' "$RAW" \
    | sed -e 's/<|[^>]*|>//g' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
    | tr '\n' ' ' \
    | sed 's/  */ /g')

# Optional LLM cleanup (contextual). Runs before the wordlist so that exact
# replacements always get the final say on domain terms.
if [[ "$LLM_CLEANUP" == "1" && -n "${RAW// }" ]]; then
    RAW=$(llm_cleanup "$RAW")
fi

# Apply the wordlist (auto-replacement for recurring mistranscriptions).
# See bin/sayit-wordlist for the matching rules.
WORDLIST="${WORDLIST:-${XDG_CONFIG_HOME:-$HOME/.config}/sayit/wordlist.tsv}"
if [[ -f "$WORDLIST" && -n "${RAW// }" ]]; then
    RAW=$(printf '%s' "$RAW" | "$REPO_ROOT/bin/sayit-wordlist" "$WORDLIST")
fi
mark t.wordlist.end

printf '%s' "$RAW"
