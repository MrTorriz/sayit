#!/usr/bin/env bash
# sayit-meter — live microphone feedback while dictating
#
# Usage:
#   sayit-meter [source]
#
# Arguments:
#   source  (optional) PipeWire source to meter — the same one the recorder
#           uses. Empty = the default microphone.
#
# Behavior:
#   - Opens its OWN low-rate capture stream (PipeWire sources allow multiple
#     concurrent readers, so the actual recording is unaffected) and turns it
#     into visible feedback that dictation hears you, without stealing focus.
#   - Three styles, chosen with RECORDING_METER_STYLE in .env:
#       overlay (default) a small pill drawn by bin/sayit-overlay: the sayit
#               mark animates with your voice, click-through so it is never
#               in the way, and freely positionable (sayit-overlay --place).
#               Needs a Wayland session with layer-shell support.
#       mark    the sayit mark in Plasma's on-screen display, animated
#               through the sayit-level-0..7 theme icons that install.sh
#               installs. Icon tone follows the desktop color scheme.
#       wave    a scrolling bar waveform in the same Plasma OSD.
#     Each style falls back to the next when its requirements are missing, so
#     the meter degrades instead of disappearing.
#   - The audio samples are used ONLY to compute a level; nothing is stored
#     or logged. Runs until killed (sayit-indicator hide), until the capture
#     stream ends, or for at most 120 s as a safety cap in the OSD styles.
#   - Silently does nothing when no style can run — the meter is feedback
#     only and must never break dictation.
#
# Exit codes:
#   0  Always

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
[[ -f "$REPO_ROOT/.env" ]] && source "$REPO_ROOT/.env"

SOURCE="${1:-}"

command -v pw-cat >/dev/null || exit 0

STYLE="${RECORDING_METER_STYLE:-overlay}"
# An unknown value in .env must not silently pick an arbitrary style.
[[ "$STYLE" =~ ^(overlay|mark|wave)$ ]] || STYLE="overlay"

# --- style selection: each step falls through to the next -----------------

# The overlay draws its own window and needs neither gdbus nor Plasma.
if [[ "$STYLE" == "overlay" ]]; then
    "$REPO_ROOT/bin/sayit-overlay" --check 2>/dev/null || STYLE="mark"
fi

# A resident overlay (sayit-overlay --resident, normally the sayit-overlay
# user service) already keeps a pill on screen. Feed THAT one through its
# FIFO instead of starting a second: the bytes are the same raw PCM a piped
# overlay would have read on stdin, and audio arriving is what tells the
# resident a recording has begun.
OVERLAY_FIFO="${XDG_RUNTIME_DIR:-/tmp}/sayit.overlay"

# The PID is trusted only after the same identity check the rest of sayit
# uses: writing into a FIFO whose reader has died would block this meter
# forever, and a recycled PID must never be mistaken for the overlay.
resident_overlay() {
    local pid cmdline
    [[ -p "$OVERLAY_FIFO" ]] || return 1
    pid=$(cat "$OVERLAY_FIFO.pid" 2>/dev/null) || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || return 1
    [[ "$cmdline" == *sayit-overlay* ]] || return 1
    return 0
}

OSD=()
OSD_ACTIVE=0
SUFFIX=""
STATIC_ICON="audio-input-microphone"
ICON_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable"

# The mark needs its complete icon set (levels 0-7 + idle) in the chosen
# tone — probing all nine keeps a partially installed set from producing
# blank OSD frames at some levels only.
mark_icons_present() {
    local l
    for l in 0 1 2 3 4 5 6 7; do
        [[ -f "$ICON_ROOT/status/sayit-level-$l$SUFFIX.svg" ]] || return 1
    done
    [[ -f "$ICON_ROOT/status/sayit-idle$SUFFIX.svg" ]]
}

if [[ "$STYLE" != "overlay" ]]; then
    # Both OSD styles need gdbus and a live Plasma OSD service to draw on.
    command -v gdbus >/dev/null || exit 0
    # Per-call timeout: a wedged plasmashell must never pin the meter for the
    # 25 s D-Bus default.
    OSD=(gdbus call --session --timeout 3 --dest org.kde.plasmashell
         --object-path /org/kde/osdService --method)
    "${OSD[@]}" org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 || exit 0

    # Icon tone for the current desktop theme, via the portal's color-scheme:
    # 1 = prefer dark UI -> light glyphs (the default icon variant), and a
    # missing portal answer is treated the same; anything else (light, no
    # preference) -> the -light (dark-glyph) variant.
    REPLY=$(gdbus call --session --timeout 1 \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.Settings.Read \
        org.freedesktop.appearance color-scheme 2>/dev/null) || REPLY=""
    [[ -z "$REPLY" || "$REPLY" == *"uint32 1"* ]] || SUFFIX="-light"

    # A missing tone variant falls back to the base set — the same rule the
    # notification icon uses in sayit and sayit-indicator.
    if [[ -n "$SUFFIX" ]] && ! mark_icons_present; then
        SUFFIX=""
    fi
    if [[ "$STYLE" != "wave" ]]; then
        mark_icons_present || STYLE="wave"
    fi
    [[ -f "$ICON_ROOT/apps/sayit$SUFFIX.svg" ]] && STATIC_ICON="sayit$SUFFIX"

    # Only the OSD styles draw there, so only they may clear it on exit:
    # hiding an OSD we never showed would dismiss someone else's.
    OSD_ACTIVE=1
fi

# --- capture and render ---------------------------------------------------

ARGS=(--record --raw --rate 8000 --channels 1 --format s16)
[[ -n "$SOURCE" ]] && ARGS+=(--target "$SOURCE")

# The pipeline runs in the background: a foreground pipeline would block
# signal traps until it ends, making the stop kill a no-op.
#
# It must also be stopped as a WHOLE. pw-cat ignores SIGPIPE (its signal mask
# has SIGPIPE blocked), so killing only the renderer does NOT starve the
# capture: pw-cat survives as an orphan with the microphone still open, for
# as long as the session lives. Job control (set -m) puts the pipeline in its
# own process group, which lets one signal take down pw-cat and the renderer
# together — on every exit path, including the normal end of the stream.
#
# The stop signal can also land BEFORE the pipeline exists, so the trap is
# armed first, guarded for empty state — and the handler must exit by itself:
# an interrupted wait on a pipeline job otherwise resumes waiting for the
# remaining pipeline members.
PIPE_PID=""
PIPE_PGID=""

# Both codes mean the same thing to different shellcheck versions: 0.10+ says
# SC2329 (never invoked), older releases say SC2317 (unreachable). CI runs an
# older shellcheck than a current Fedora, so both have to be listed or the
# lint job fails on a function the traps below do call.
# shellcheck disable=SC2329,SC2317
stop_capture() {
    if [[ -n "$PIPE_PGID" ]]; then
        kill -- -"$PIPE_PGID" 2>/dev/null || true
    elif [[ -n "$PIPE_PID" ]]; then
        kill "$PIPE_PID" 2>/dev/null || true
    fi
}

# Both codes mean the same thing to different shellcheck versions: 0.10+ says
# SC2329 (never invoked), older releases say SC2317 (unreachable). CI runs an
# older shellcheck than a current Fedora, so both have to be listed or the
# lint job fails on a function the traps below do call.
# shellcheck disable=SC2329,SC2317
cleanup() {
    stop_capture
    if [[ $OSD_ACTIVE -eq 1 ]]; then
        "${OSD[@]}" org.kde.osdService.hide >/dev/null 2>&1 || true
    fi
    return 0
}

trap cleanup EXIT
trap 'cleanup; exit 0' INT TERM HUP

set -m
if [[ "$STYLE" == "overlay" ]] && resident_overlay; then
    # No renderer of our own: the capture stream alone, pointed at the pill
    # that is already up. Stopping this meter closes the FIFO's only writer,
    # which is how the resident learns the recording ended.
    pw-cat "${ARGS[@]}" - 2>/dev/null > "$OVERLAY_FIFO" &
elif [[ "$STYLE" == "overlay" ]]; then
    pw-cat "${ARGS[@]}" - 2>/dev/null \
        | "$REPO_ROOT/bin/sayit-overlay" >/dev/null 2>&1 &
else
    pw-cat "${ARGS[@]}" - 2>/dev/null | python3 -c '
import array, math, os, subprocess, sys

STYLE, SUFFIX, STATIC_ICON = sys.argv[1:4]
OSD = sys.argv[4:]
PPID = os.getppid()
GLYPHS = "▁▂▃▄▅▆▇█"
# RMS thresholds (s16 samples) -> level 0..7; roughly log-spaced over the
# range of quiet room noise up to loud speech on a 16 kHz/mSBC microphone.
LEVELS = [90, 200, 450, 900, 1800, 3500, 7000]
hist = [0] * 12
frames = 0
while frames < 960:                       # safety cap: ~120 s at 8 fps
    if os.getppid() != PPID:              # meter shell died mid-signal
        break                             # -> never run on as an orphan
    data = sys.stdin.buffer.read(2000)    # 125 ms at 8 kHz s16 mono
    if len(data) < 4:
        break
    samples = array.array("h", data[: len(data) // 2 * 2])
    rms = math.sqrt(sum(x * x for x in samples) / len(samples))
    level = sum(1 for t in LEVELS if rms >= t)
    if STYLE == "mark":
        # The mark IS the meter: bar heights follow the voice level; in
        # silence the red dot pulses (~0.6 s) as the "mic is open" cue.
        if level == 0 and (frames // 5) % 2:
            icon = "sayit-idle" + SUFFIX
        else:
            icon = "sayit-level-%d%s" % (level, SUFFIX)
        text = "sayit"
    else:
        hist = hist[1:] + [level]
        icon = STATIC_ICON
        text = "".join(GLYPHS[l] for l in hist)
    subprocess.run(
        OSD + ["org.kde.osdService.showText", icon, text],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    frames += 1
'  "$STYLE" "$SUFFIX" "$STATIC_ICON" "${OSD[@]}" &
fi
PIPE_PID=$!
set +m
# Group id of the pipeline, for the whole-group stop above. An empty answer
# just falls back to signalling the renderer alone.
PIPE_PGID=$(ps -o pgid= -p "$PIPE_PID" 2>/dev/null | tr -d ' ') || PIPE_PGID=""
[[ "$PIPE_PGID" =~ ^[0-9]+$ ]] || PIPE_PGID=""

wait "$PIPE_PID" 2>/dev/null || true

exit 0
