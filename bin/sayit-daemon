#!/usr/bin/env bash
# sayit-daemon — start a warm whisper-server with .env-driven flags
#
# Usage:
#   sayit-daemon
#
# Behavior:
#   - Reads configuration from .env (MODEL_PATH, SPEECH_LANGUAGE, THREADS,
#     DAEMON_PORT, VAD_MODEL, BEAM, INITIAL_PROMPT)
#   - Starts whisper-server, keeping the model warm in RAM/GPU
#   - Enables VAD when VAD_MODEL points to an existing file (less
#     hallucination on trailing silence), flash attention and beam search
#   - Run by the systemd service sayit-daemon.service (exec, no fork), or on
#     macOS by the LaunchAgent io.github.mrtorriz.sayit.daemon
#   - SAYIT_DAEMON_LOG (set by the macOS LaunchAgent): append this script's
#     own errors and the server's output there. At each start a file past
#     1 MiB is moved to .1 first - launchd rotates nothing, and the server
#     writes timings for every request (never the transcribed text). A server
#     that runs for weeks is rotated at its next start, not before.
#
# Exit codes:
#   1  Model or whisper-server missing
#
# Note: this is a wrapper so that model switching (medium <-> large) and
# VAD/beam settings are controlled entirely from .env without editing the
# service file.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
[[ -f "$REPO_ROOT/.env" ]] && source "$REPO_ROOT/.env"

# Before any check, so a missing model or binary is in the log, not lost.
if [[ -n "${SAYIT_DAEMON_LOG:-}" ]]; then
    mkdir -p "$(dirname "$SAYIT_DAEMON_LOG")"
    if [[ -f "$SAYIT_DAEMON_LOG" ]] && (( $(wc -c < "$SAYIT_DAEMON_LOG") > 1048576 )); then
        mv -f "$SAYIT_DAEMON_LOG" "$SAYIT_DAEMON_LOG.1"
    fi
    exec >>"$SAYIT_DAEMON_LOG" 2>&1
fi

WHISPER_SERVER="${WHISPER_SERVER:-$HOME/.local/src/whisper.cpp/build/bin/whisper-server}"
[[ -x "$WHISPER_SERVER" ]] || { echo "whisper-server missing — run install.sh" >&2; exit 1; }

# SAYIT_MODEL (environment variable) wins over .env:MODEL_PATH — for
# temporary A/B switching between models without editing .env (e.g. via
# `systemctl --user set-environment SAYIT_MODEL=...`).
# The default model. On Apple Silicon the large model answers faster than
# medium does on the Linux reference machine (docs/PERFORMANCE.md), so macOS
# prefers it whenever it is installed.
DEFAULT_MODEL="$REPO_ROOT/models/ggml-kb-whisper-medium-q5_0.bin"
if [[ "$OSTYPE" == darwin* && "$HOSTTYPE" == a*64 \
      && -f "$REPO_ROOT/models/ggml-kb-whisper-large-q5_0.bin" ]]; then
    DEFAULT_MODEL="$REPO_ROOT/models/ggml-kb-whisper-large-q5_0.bin"
fi
MODEL="${SAYIT_MODEL:-${MODEL_PATH:-$DEFAULT_MODEL}}"
[[ -f "$MODEL" ]] || { echo "Model missing: $MODEL — run install.sh" >&2; exit 1; }

SPEECH_LANGUAGE="${SPEECH_LANGUAGE:-sv}"
THREADS="${THREADS:-8}"
DAEMON_PORT="${DAEMON_PORT:-9876}"
BEAM="${BEAM:-5}"

ARGV=(
    --model "$MODEL"
    --language "$SPEECH_LANGUAGE"
    --threads "$THREADS"
    --beam-size "$BEAM"
    --flash-attn
    --suppress-nst
    --host 127.0.0.1
    --port "$DAEMON_PORT"
)

# Optional: suppress specific recurring junk tokens (regex). Empty = off.
# Only forwarded when this whisper-server build supports the flag — older
# builds exit on unknown arguments (with status 0, defeating Restart=on-failure),
# which would kill daemon mode permanently the moment the option is set.
SUPPRESS_REGEX="${SUPPRESS_REGEX:-}"
if [[ -n "$SUPPRESS_REGEX" ]]; then
    if "$WHISPER_SERVER" --help 2>&1 | grep -q -- --suppress-regex; then
        ARGV+=(--suppress-regex "$SUPPRESS_REGEX")
    else
        echo "warning: this whisper-server lacks --suppress-regex; SUPPRESS_REGEX applies to the CLI fallback only" >&2
    fi
fi

# VAD: filters out non-speech before the model sees it -> less hallucination.
# Only enabled when VAD_MODEL exists on disk.
VAD_MODEL="${VAD_MODEL:-$REPO_ROOT/models/ggml-silero-v5.1.2.bin}"
if [[ -f "$VAD_MODEL" ]]; then
    ARGV+=(--vad --vad-model "$VAD_MODEL")
fi

exec "$WHISPER_SERVER" "${ARGV[@]}"
