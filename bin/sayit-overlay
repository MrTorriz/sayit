#!/usr/bin/env python3
# sayit-overlay — compact voice meter in a small always-on-top pill
#
# Usage:
#   sayit-overlay              # read raw audio on stdin and render the meter
#   sayit-overlay --resident   # stay on screen; read audio from the FIFO
#   sayit-overlay --place      # a pill on its own to drag; Enter/Escape saves
#   sayit-overlay --check      # exit 0 only if this desktop can host it
#   sayit-overlay --print-position
#
# Input:
#   Raw mono 16-bit little-endian PCM at 8 kHz (what sayit-meter pipes in
#   from pw-cat), on stdin normally and on $XDG_RUNTIME_DIR/sayit.overlay
#   under --resident. The samples are used ONLY to compute a level; nothing
#   is stored or logged. In the piped mode end of stream ends the overlay.
#
# The two modes differ only in lifetime. Piped, the pill exists exactly as
# long as a recording does, which is what sayit-meter starts when nothing
# else is on screen. Resident, one pill stays up from login (the
# sayit-overlay.service user unit) and sayit-meter feeds that one instead of
# starting a second: audio arriving on the FIFO IS the recording signal, and
# AUDIO_IDLE_S without any is the end of it.
#
# Behavior:
#   - Draws its own borderless window through the layer-shell protocol, so it
#     floats above normal windows without ever taking focus — the keyboard
#     is never taken, in any mode.
#   - Resident and idle it sits on the TOP layer, so a fullscreen window
#     covers it. A recording raises it to the OVERLAY layer, which is above
#     fullscreen: while the microphone is live the pill is never hidden.
#   - Reading order is lamp, meter, wordmark. The eight bars follow the voice
#     level, growing symmetrically about the pill's centre line and standing
#     still when nothing drives them. The wordmark is stored as outlines, so
#     no font is needed at runtime.
#   - Three states, and the lamp tells them apart honestly. Microphone closed:
#     no lamp at all. Open but silent: a steady lamp, the meter at rest.
#     Open and speaking: the same steady lamp, and the meter is the ONLY
#     thing that moves. Colour and brightness never carry the difference.
#   - Position is remembered in $XDG_CONFIG_HOME/sayit/overlay-position
#     (default ~/.config/sayit/). Without one it starts bottom centre.
#   - A RESIDENT pill can be dragged at any time, with no mode to enter: it
#     keeps a normal input region, so a click on its own 110x40 px is taken
#     by the pill and a drag moves it. The piped pill keeps the empty region
#     and stays click-through — it is on screen for seconds at a time and
#     must never be in the way, and there is nothing to move it to.
#     --place therefore only opens a pill of its own when no resident is
#     running; against one, it says the pill is already draggable.
#   - Exits silently when the desktop cannot host it (no Wayland session, no
#     layer-shell support, missing bindings) — sayit-meter then falls back to
#     the Plasma OSD styles. Feedback must never break dictation. --resident
#     is the exception: nothing downstream depends on it, and reporting the
#     failure is what lets the service unit retry once the session is up.
#
# This is the one script in bin/ that is Python rather than bash: it owns a
# drawn window and an animation loop, which bash cannot express.
#
# Exit codes:
#   0  Always, except --check and --resident on a desktop that cannot host it
#   1  --check and --resident only: no Wayland session, missing bindings, no
#      display, or (--resident) no FIFO to read

import math
import os
import stat
import struct
import sys
import time

# 160x40. The height is what a panel dictates: measured, a default Plasma
# panel is 44 px, so 40 fills it with 2 px to spare rather than floating in
# the middle of it. The width follows from the content -- lamp, a ten-bar
# meter and the wordmark, in that reading order. RADIUS and everything under
# "mark geometry" are proportional to HEIGHT, so the shape survives a resize.
WIDTH, HEIGHT, RADIUS = 160, 40, 12
BORDER = 1.2
LAYOUT_GAP = 12.0                   # between the meter and the wordmark
# The lamp stands further off than the wordmark does. It is a status light,
# not a letterform, and the extra air both separates the two ideas and pushes
# the lamp out towards the pill's left shoulder, where the eye finds it first.
LAMP_GAP = 8.0
EDGE_MARGIN = 2                     # keeps the pill off the very screen edge
FPS_MS = 33                         # ~30 fps redraw, independent of audio rate
# Idle costs nothing to look at, so it must cost nothing to draw either: at
# rest the pill is a still image and a 4 fps timer is only there to notice
# that audio has started. A resident pill runs for the whole session.
IDLE_FPS_MS = 250
AUDIO_IDLE_S = 0.4                  # no audio for this long = mic closed
CHUNK = 2000                        # 125 ms of 8 kHz s16 mono
EASE = 0.35                         # level smoothing per frame
PLACE_TIMEOUT_FRAMES = 180 * 1000 // FPS_MS   # --place gives up after 3 min
# RMS thresholds (s16 samples) -> level 0..7, matching bin/sayit-meter.
LEVELS = [90, 200, 450, 900, 1800, 3500, 7000]

# --- mark geometry --------------------------------------------------------
# The mark stays in the same 96-unit design space as icons/*.svg and is scaled
# into the pill at draw time, rather than being written out in pre-scaled
# pixels. Keeping the mark's own units means this geometry can still be read
# against the logo and against the Windows indicator without decoding a second
# set of numbers, and the pill can be resized without recomputing any of it.
# The content is scaled as one group -- lamp, meter and wordmark together --
# so it fills the pill rather than floating in a field of black. Twice now the
# fix for "it looks thin" has been to raise these three numbers in step, never
# to redraw anything. The tallest bar still clears the pill edge by 8.6 px.
MARK_SCALE = 0.3562
BAR_COUNT = 10
BAR_U = 11.0                        # bar width, and its height at rest
GAP_U = 3.0                         # tightened as the bars thickened, so the
                                    # row gained weight rather than width
# Height at level 7, per bar. An uneven row reads as a voice rather than as a
# progress bar; the values are a fixed pattern, not a measurement. The row
# opens low, peaks in the middle and settles again, so the two outermost bars
# are the quietest -- a phrase rather than a block.
BAR_MAX_U = [32.32, 38.08, 58.24, 45.76, 64.00,
             42.40, 53.44, 36.16, 59.68, 40.00]
DOT_D = 42.0                        # the lamp, deliberately larger than the bars ask for
# The lamp is always on the pill and never moves; only its colour carries the
# state. Lit means the microphone is open. Unlit is a dark red that still
# reads as a lamp -- an indicator light does not vanish when it goes out, it
# stops glowing, and a pill with a hole where the lamp was looks broken.
LAMP_LIT = (1.0, 0.30, 0.30)
LAMP_UNLIT = (0.42, 0.13, 0.15)

WAVE_W_U = BAR_COUNT * BAR_U + (BAR_COUNT - 1) * GAP_U
LAMP_W = DOT_D * MARK_SCALE
WAVE_W = WAVE_W_U * MARK_SCALE

# --- the wordmark ---------------------------------------------------------
# "sayit" as Bezier outlines rather than as text. The shapes came from Libre
# Franklin Black Italic at 14.5 px with -0.10 px tracking, converted once and
# stored here, so the pill draws identically on a machine that has never heard
# of that font. Nothing at runtime asks for a font, and no font file lives in
# this repository.
#
# Normalised to height 1.0 with the origin at the wordmark's own top left, so
# WORDMARK_H is the only number that sets its size.
WORDMARK_H = 21.875                 # cap-to-descender height in pill pixels
WORDMARK_ASPECT = 2.396638
