#!/usr/bin/env bash
# sayit-record — record mono 16 kHz WAV until SIGINT/SIGTERM (PipeWire on
# Linux, Core Audio through Sayit.app's sayit-rec on macOS)
#
# Usage:
#   sayit-record <outfile.wav> [source]
#
# Arguments:
#   outfile.wav  Path where the recording is saved (overwritten without warning)
#   source       (optional) PipeWire target overriding AUDIO_SOURCE, e.g. a
#                bluez_input source from sayit-bt. Empty = AUDIO_SOURCE or
#                the PipeWire default mic. On macOS a device name or UID; a
#                PipeWire node name that embeds the device name also matches.
#
# Behavior:
#   - Format: PCM s16le, 16 kHz mono (whisper.cpp-compatible)
#   - Recording source: argument 2 if set, otherwise AUDIO_SOURCE from .env,
#     otherwise the PipeWire default mic
#   - Records until the process receives SIGINT or SIGTERM
#   - macOS: execs sayit-rec, which also publishes the level for the pill and
#     stops itself after MAX_RECORD_SECONDS (default 120)
#
# Exit codes:
#   0  Normal termination (SIGINT)
#   >0 pw-record or sayit-rec failed (2 = microphone permission denied)

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
[[ -f "$REPO_ROOT/.env" ]] && source "$REPO_ROOT/.env"

OUTFILE="${1:?Usage: sayit-record <outfile.wav> [source]}"
SOURCE="${2:-${AUDIO_SOURCE:-}}"

# macOS: sayit-rec and sayit-paste live in Sayit.app, whose Microphone and
# Accessibility permissions they run under. SAYIT_MAC_HELPERS is set by the app.
mac_helper() {
    local dir
    for dir in "${SAYIT_MAC_HELPERS:-}" "$HOME/Applications/Sayit.app/Contents/MacOS" \
               "/Applications/Sayit.app/Contents/MacOS" \
               "$REPO_ROOT/mac/build/Sayit.app/Contents/MacOS"; do
        [[ -n "$dir" && -x "$dir/$1" ]] && { printf '%s\n' "$dir/$1"; return 0; }
    done
    return 1
}

if [[ "$OSTYPE" == darwin* ]]; then
    REC=$(mac_helper sayit-rec) || { echo "sayit-rec missing — run ./install.sh" >&2; exit 1; }
    export MAX_RECORD_SECONDS="${MAX_RECORD_SECONDS:-120}"
    exec "$REC" "$OUTFILE" "$SOURCE"
fi

ARGS=(--rate 16000 --channels 1 --format=s16)
[[ -n "$SOURCE" ]] && ARGS+=(--target "$SOURCE")

exec pw-record "${ARGS[@]}" "$OUTFILE"
